/android/app/debug
/android/app/profile
/android/app/release

# Evidence system (see CLAUDE.md).
# The stitched .mp4 IS committed — it is what gets linked from the PR.
# The intermediate PNG frames are not.
/evidence/frames/
/evidence/**/*.png
